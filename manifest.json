{
  "manifest_version": 3,
  "name": "Threads AI — ассистент DeepSeek",
  "version": "0.1.0",
  "description": "AI-ассистент на Threads: читает ленту, ищет, отвечает и публикует посты от вашего имени через DeepSeek / OpenCode Zen.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Threads AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.com/*",
        "https://www.threads.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://opencode.ai/*",
    "https://api.deepseek.com/*",
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://html.duckduckgo.com/*",
    "https://*/*"
  ]
}